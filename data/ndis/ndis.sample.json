{
  "meta": {
    "title": "Common Ground — NDIS Tracker",
    "as_of": "2026-08-18",
    "disclaimer": "Independent, non-partisan tracker of NDIS pricing, legislation and scheme data drawn from official primary sources. Every figure and claim links to its source; nothing here is legal, financial or medical advice. Not affiliated with the NDIA, the NDIS Commission or any political party.",
    "methodology": "Price changes are diffed release over release from the NDIS Support Catalogue as published by the NDIA. Where a release reports separate state or territory prices, the price shown is the national (modal) value and the range across jurisdictions is shown as a spread band; the 2026-27 catalogue replaced state-based pricing with a single National price, so no spread is shown for that release. Scheme size and category figures are aggregated from NDIA quarterly datasets; disability prevalence figures are drawn separately from the ABS Census and the Survey of Disability, Ageing and Carers and are not interchangeable measures — each is labelled with its own source.",
    "current_release": "2026-27-v1.1"
  },
