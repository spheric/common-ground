{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-ground.example/schema/dataset.schema.json",
  "title": "Common Ground dataset",
  "description": "Australian federal party policy positions, by topic and issue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "parties", "stances", "impact_tags", "topics"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "as_of", "jurisdiction", "disclaimer", "methodology"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "as_of": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "disclaimer": { "type": "string", "minLength": 1 },
        "methodology": { "type": "string", "minLength": 1 }
      }
    },
    "parties": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/party" }
    },
    "stances": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/stanceDef" }
    },
    "impact_tags": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/impactTag" }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "partyId": {
      "type": "string",
      "enum": ["labor", "coalition", "greens", "one_nation"]
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "abbr", "leader", "role", "color_light", "color_dark"],
      "properties": {
        "id": { "$ref": "#/$defs/partyId" },
        "name": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1 },
        "abbr": { "type": "string", "minLength": 1 },
        "leader": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["Government", "Opposition", "Crossbench"] },
        "color_light": { "$ref": "#/$defs/hexColor" },
        "color_dark": { "$ref": "#/$defs/hexColor" }
      }
    },
    "stanceDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "symbol"],
      "properties": {
        "id": { "type": "string", "enum": ["supports", "opposes", "mixed", "no_position"] },
        "label": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "impactTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "emoji"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string", "minLength": 1 }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "issues"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "question", "positions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1, "pattern": "\\?$" },
        "positions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/position" }
        },
        "voting": { "$ref": "#/$defs/voting" }
      }
    },
    "voting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "records"],
      "properties": {
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/votingRecord" }
        }
      }
    },
    "votingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "polarity", "strength", "note", "name", "description", "url", "provisional", "divisions_total", "houses", "first_division_date", "last_division_date", "parties"],
      "properties": {
        "policy_id": { "type": "integer", "minimum": 1 },
        "polarity": { "enum": [1, -1] },
        "strength": { "type": "string", "enum": ["direct", "related"] },
        "note": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://theyvoteforyou\\.org\\.au/policies/\\d+$" },
        "provisional": { "type": "boolean" },
        "divisions_total": { "type": "integer", "minimum": 0 },
        "houses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["representatives", "senate"],
          "properties": {
            "representatives": { "type": "integer", "minimum": 0 },
            "senate": { "type": "integer", "minimum": 0 }
          }
        },
        "first_division_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "last_division_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "parties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labor", "coalition", "greens", "one_nation"],
          "properties": {
            "labor": { "$ref": "#/$defs/votingPartyStats" },
            "coalition": { "$ref": "#/$defs/votingPartyStats" },
            "greens": { "$ref": "#/$defs/votingPartyStats" },
            "one_nation": { "$ref": "#/$defs/votingPartyStats" }
          }
        }
      }
    },
    "votingPartyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "voted", "for", "against", "mixed", "median_agreement", "mean_agreement"],
      "properties": {
        "members": { "type": "integer", "minimum": 0 },
        "voted": { "type": "integer", "minimum": 0 },
        "for": { "type": "integer", "minimum": 0 },
        "against": { "type": "integer", "minimum": 0 },
        "mixed": { "type": "integer", "minimum": 0 },
        "median_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "mean_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "stance", "summary", "impacts", "impact_note", "confidence", "verified", "sources"],
      "properties": {
        "party": { "$ref": "#/$defs/partyId" },
        "stance": { "type": "string", "enum": ["supports", "opposes", "mixed", "no_position"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 350 },
        "impacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "impact_note": { "type": "string", "minLength": 1, "maxLength": 200 },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "verified": { "type": "string", "enum": ["confirmed", "corrected", "unverified"] },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      },
      "if": {
        "properties": { "stance": { "const": "no_position" } },
        "required": ["stance"]
      },
      "then": {
        "properties": {
          "sources": { "type": "array" }
        }
      },
      "else": {
        "properties": {
          "sources": { "type": "array", "minItems": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpUrl" },
        "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
        "publisher": { "type": "string", "minLength": 1 }
      }
    }
  }
}
